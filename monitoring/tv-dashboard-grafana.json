{
  "dashboard": {
    "id": null,
    "title": "TV Dashboard - Business Metrics",
    "tags": ["tv-dashboard", "business"],
    "style": "dark",
    "timezone": "",
    "description": "Real-time monitoring dashboard for TV Dashboard application showing streaming platform metrics, API performance, and system health",
    "panels": [
      {
        "id": 1,
        "title": "Backend Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"tv-dashboard-backend\"}",
            "legendFormat": "Backend Status",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "DOWN"}}, "type": "value"},
              {"options": {"1": {"text": "UP"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Active Database Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "database_connections_active",
            "legendFormat": "DB Connections",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total TV Shows in Database",
        "type": "stat",
        "targets": [
          {
            "expr": "tv_shows_in_database_total",
            "legendFormat": "TV Shows Count",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "Environment",
        "type": "stat",
        "targets": [
          {
            "expr": "count by (namespace) (tv_shows_requested_total)",
            "legendFormat": "{{namespace}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "title": "TV Shows Requested by Platform",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (platform) (tv_shows_requested_total{namespace=\"tv-dashboard-dev\"})",
            "legendFormat": "{{platform}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "xAxis": {"show": true},
        "yAxes": [
          {"label": "shows requested", "show": true},
          {"show": true}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": false
        },
        "nullPointMode": "null"
      },
      {
        "id": 6,
        "title": "HTTP Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "xAxis": {"show": true},
        "yAxes": [
          {"label": "requests/sec", "show": true},
          {"show": true}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": false
        },
        "nullPointMode": "null"
      },
      {
        "id": 7,
        "title": "Response Time (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
        "xAxis": {"show": true},
        "yAxes": [
          {"label": "seconds", "show": true},
          {"show": true}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": false
        },
        "nullPointMode": "null"
      },
      {
        "id": 8,
        "title": "External API Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(external_api_requests_total[5m])",
            "legendFormat": "External API calls/sec",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
        "xAxis": {"show": true},
        "yAxes": [
          {"label": "requests/sec", "show": true},
          {"show": true}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true,
          "values": false
        },
        "nullPointMode": "null"
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "5s",
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}
